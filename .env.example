# All settings below are optional - the agent runs with working defaults
# out of the box. Copy this file to .env and uncomment/change only what
# you need. The payment-verification API itself does not require a key.

# API_BASE_URL=https://se-payment-verification-api.service.external.usea2.aws.prodigaltech.com
# HTTP_TIMEOUT_SECONDS=10
# HTTP_MAX_RETRIES=1
# MAX_VERIFICATION_ATTEMPTS=3
# MAX_ACCOUNT_LOOKUP_ATTEMPTS=3
# MAX_PAYMENT_ATTEMPTS=3
# LOG_LEVEL=INFO

# Optional: enables LLM-based field extraction (llm_extractor.py) and
# response phrasing (responder.py) as the primary path for both, with the
# deterministic regex parser / fixed templates as the automatic fallback
# whenever no key is set or every configured LLM call fails. Without any
# of this the agent runs exactly as it would with it, just using the
# deterministic path for every turn - no feature is lost, only NL
# coverage and response variety.
#
# Uses Groq's OpenAI-compatible endpoint by default (https://console.groq.com) -
# free, no billing setup required, good for a quick start.
# GROQ_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-20b
#
# To use OpenAI itself as the primary provider instead (more reliable in
# practice if you have a funded account - no free-tier rate limits to run
# into), set these instead of GROQ_API_KEY. LLM_USES_REASONING_EFFORT must
# be false here: gpt-4o-mini is a standard model, not a reasoning model,
# and rejects that parameter outright (confirmed directly against the API).
# LLM_API_KEY=sk-proj-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_USES_REASONING_EFFORT=false

# Optional second provider, attempted only if the primary call itself
# fails (network error, rate limit, timeout) - before giving up on the
# LLM path entirely. Defaults to OpenRouter (https://openrouter.ai), which
# is OpenAI-compatible the same way Groq is. This matters in practice: a
# free-tier primary key can genuinely run out of quota under heavy use,
# and this is what keeps the LLM layer engaged rather than silently
# reverting to the deterministic-only experience for the rest of the
# session.
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
#
# Not every model/provider supports *forcing* a specific tool call the
# way Groq's does - test this directly before changing it. If your
# fallback model rejects a forced tool choice (a 400 error), set this to
# false; extraction will use tool_choice="auto" instead, which is less
# reliable (the model can decide not to call the tool even when there's
# something to extract) but still better than no fallback at all.
# LLM_FALLBACK_SUPPORTS_FORCED_TOOL_CHOICE=true